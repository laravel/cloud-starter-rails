<!doctype html>
<!-- Laravel Cloud welcome screen. Replace it with the app's own home page. -->
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Rails on Laravel Cloud</title>
        <link rel="preconnect" href="https://fonts.bunny.net" />
        <link href="https://fonts.bunny.net/css?family=instrument-sans:400,500,600" rel="stylesheet" />
        <style>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --page: #fdfdfc;
                --text: #1b1b18;
                --muted: #706f6c;
                --card: #ffffff;
                --card-border: rgba(26, 26, 0, 0.16);
                --line: #e3e3e0;
                --dot: #dbdbd7;
                --link: #006aff;
                --button: #1b1b18;
                --button-text: #ffffff;
                --button-hover: #000000;
                --art-cover: #ffffff;
                --art-text: #00080c;
                --brand: #00080c;
                --brand-muted: #a6acb0;
                color-scheme: light dark;
            }

            @media (prefers-color-scheme: dark) {
                :root {
                    --page: #0a0a0a;
                    --text: #ededec;
                    --muted: #a1a09a;
                    --card: #161615;
                    --card-border: #fffaed2d;
                    --line: #3e3e3a;
                    --dot: #3e3e3a;
                    --link: #83b7ff;
                    --button: #eeeeec;
                    --button-text: #1c1c1a;
                    --button-hover: #ffffff;
                    --art-cover: #0a0a0a;
                    --art-text: #ffffff;
                    --brand: #ffffff;
                    --brand-muted: #a6acb0;
                }
            }

            body {
                display: flex;
                flex-direction: column;
                align-items: center;
                min-height: 100vh;
                padding: 1.5rem;
                background: var(--page);
                color: var(--text);
                font-family: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif;
                -webkit-font-smoothing: antialiased;
            }

            .brand {
                width: 100%;
                max-width: 335px;
                margin-bottom: 1.5rem;
                color: var(--brand);
            }

            .brand a {
                display: inline-block;
                color: inherit;
            }

            .brand svg {
                display: block;
                width: 13rem;
                height: auto;
            }

            .welcome {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                width: 100%;
                transition: opacity 750ms;
                @starting-style {
                    opacity: 0;
                }
            }

            main {
                display: flex;
                flex-direction: column-reverse;
                width: 100%;
                max-width: 335px;
            }

            .card {
                flex: 1;
                padding: 1.5rem;
                font-size: 13px;
                line-height: 20px;
                background: var(--card);
                box-shadow: inset 0 0 0 1px var(--card-border);
                border-radius: 0 0 0.5rem 0.5rem;
            }

            h1 {
                margin-bottom: 0.25rem;
                font-size: inherit;
                font-weight: 500;
            }

            .muted {
                color: var(--muted);
            }

            .intro {
                margin-bottom: 0.5rem;
            }

            .steps {
                display: flex;
                flex-direction: column;
                margin-bottom: 1rem;
                list-style: none;
            }

            .steps li {
                position: relative;
                display: flex;
                align-items: center;
                gap: 1rem;
                padding: 0.5rem 0;
            }

            .steps li::before {
                content: '';
                position: absolute;
                left: 0.4rem;
                border-left: 1px solid var(--line);
            }

            .steps li:first-child::before {
                top: 50%;
                bottom: 0;
            }

            .steps li:last-child::before {
                top: 0;
                bottom: 50%;
            }

            .steps li:only-child::before {
                display: none;
            }

            .marker {
                position: relative;
                padding: 0.25rem 0;
                background: var(--card);
            }

            .marker span {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 0.875rem;
                height: 0.875rem;
                border: 1px solid var(--line);
                border-radius: 9999px;
                background: var(--page);
                box-shadow:
                    0 0 1px 0 rgba(0, 0, 0, 0.03),
                    0 1px 2px 0 rgba(0, 0, 0, 0.06);
            }

            .marker span::after {
                content: '';
                width: 0.375rem;
                height: 0.375rem;
                border-radius: 9999px;
                background: var(--dot);
            }

            .link {
                display: inline-flex;
                align-items: center;
                gap: 0.25rem;
                margin-left: 0.25rem;
                color: var(--link);
                font-weight: 500;
                text-decoration: underline;
                text-underline-offset: 4px;
            }

            .link svg {
                width: 0.625rem;
                height: 0.625rem;
            }

            .button {
                display: inline-block;
                padding: 0.375rem 1.25rem;
                border: 1px solid var(--button);
                border-radius: 0.125rem;
                background: var(--button);
                color: var(--button-text);
                font-size: 0.875rem;
                line-height: 1.5;
                text-decoration: none;
            }

            .button:hover {
                border-color: var(--button-hover);
                background: var(--button-hover);
            }

            .version {
                margin-top: 1.5rem;
            }

            .art {
                position: relative;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                width: 100%;
                aspect-ratio: 335 / 364;
                margin-bottom: -1px;
                overflow: hidden;
                border-radius: 0.5rem 0.5rem 0 0;
                color: var(--art-text);
            }

            .art::after {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: inherit;
                box-shadow: inset 0 0 0 1px var(--card-border);
                pointer-events: none;
            }

            .art > svg {
                position: absolute;
                inset: 0;
            }

            .art .noise {
                width: 200%;
                animation: drift 6s linear infinite;
            }

            .art .cover {
                color: var(--art-cover);
            }

            .art .name {
                position: relative;
                padding: 0.5rem 0.875rem;
                background: var(--art-cover);
                font-size: 3rem;
                font-weight: 600;
                letter-spacing: -0.02em;
                line-height: 1;
            }

            @keyframes drift {
                to {
                    transform: translateX(-50%);
                }
            }

            @media (prefers-reduced-motion: reduce) {
                .art .noise {
                    animation: none;
                }
            }

            @media (min-width: 64rem) {
                body {
                    justify-content: center;
                    padding: 2rem;
                }

                .brand,
                main {
                    max-width: 56rem;
                }

                main {
                    flex-direction: row;
                }

                .card {
                    padding: 5rem 4rem 2.5rem;
                    border-radius: 0.5rem 0 0 0.5rem;
                }

                .intro {
                    white-space: nowrap;
                }

                .steps {
                    margin-bottom: 1.5rem;
                }

                .version {
                    margin-top: 2.5rem;
                }

                .art {
                    flex-shrink: 0;
                    width: 438px;
                    aspect-ratio: auto;
                    margin: 0 0 0 -1px;
                    border-radius: 0 0.5rem 0.5rem 0;
                }
            }
        </style>
    </head>
    <body>
        <div class="welcome">
            <header class="brand">
                <a href="https://cloud.laravel.com" target="_blank" aria-label="Laravel Cloud">
